# Copia este archivo a .env y CAMBIA las contraseñas antes de desplegar en un servidor público.
# docker compose lee .env automáticamente.

# Contraseña de root de MySQL (administración de la BD).
DB_ROOT_PASSWORD=cambia-esto-root

# Usuario y contraseña que usa la aplicación para conectarse a la BD.
DB_USER=naturdex
DB_PASSWORD=cambia-esto-app

# Puerto en el que se publica la web en el host.
WEB_PORT=8080
