# Copia este archivo a .env y define contraseñas FUERTES antes de desplegar.
# docker compose lee .env automáticamente. Las contraseñas son OBLIGATORIAS: sin ellas,
# `docker compose up` falla en vez de arrancar con credenciales débiles.
# Genera valores aleatorios, p. ej.:  openssl rand -base64 24

# Contraseña de root de MySQL (administración de la BD).
DB_ROOT_PASSWORD=

# Usuario y contraseña que usa la aplicación para conectarse a la BD.
DB_USER=naturdex
DB_PASSWORD=

# Puerto en el que se publica la web en el host.
WEB_PORT=8080
