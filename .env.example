# Copia este archivo a .env y define contraseñas FUERTES antes de desplegar.
# docker compose lee .env automáticamente. Las contraseñas son OBLIGATORIAS: sin ellas,
# `docker compose up` falla en vez de arrancar con credenciales débiles.
# Genera valores aleatorios, p. ej.:  openssl rand -base64 24

# Contraseña de root de MySQL (administración de la BD).
DB_ROOT_PASSWORD=

# Usuario y contraseña que usa la aplicación para conectarse a la BD.
DB_USER=naturdex
DB_PASSWORD=

# Puerto en el que se publica la web en el host (solo desarrollo local por HTTP).
WEB_PORT=8080

# OPCIONAL — clave de AEMET OpenData, para el widget del tiempo de la cabecera del parque.
# Se pide gratis con un correo en https://opendata.aemet.es/centrodedescargas/obtencionAPIKey y la
# envían por email; es un JWT largo. Sin ella no se rompe nada: Backend/Api/tiempo.php responde 503
# y el widget simplemente no se pinta.
# NUNCA en Frontend/: esa carpeta la sirve un servidor estático y la cachea el Service Worker, así
# que una clave ahí es una clave publicada. El navegador solo habla con Backend/Api/tiempo.php.
# AEMET_API_KEY=

# SOLO PRODUCCIÓN (docker-compose.prod.yml): dominio público de la app. Debe apuntar por DNS
# (registro A) a la IP del servidor; Caddy obtiene el certificado HTTPS solo. Para probar el
# despliegue de producción en tu PC sin dominio, usa DOMAIN=localhost.
# DOMAIN=naturdex.example.com
