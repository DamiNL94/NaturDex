{
  "name": "naturdex",
  "version": "0.1.0",
  "private": true,
  "description": "NaturDex — guía ambiental virtual de parques (prototipo, orientado a móvil/PWA).",
  "scripts": {
    "validate": "node Tools/validate-park-data.js",
    "taxones:duplicados": "node Tools/scan-taxones-duplicados.js",
    "export:park": "php Tools/export-park.php",
    "export:glossary": "php Tools/export-glossary.php",
    "glossary:check": "node Tools/glossary-coverage.js",
    "export:invasoras": "php Tools/export-invasoras.php",
    "db:status": "node Tools/db-sync/db-sync.js status",
    "db:pull": "node Tools/db-sync/db-sync.js pull",
    "db:push": "node Tools/db-sync/db-sync.js push",
    "db:backup": "node Tools/db-sync/db-sync.js backup",
    "hooks:install": "git config core.hooksPath .githooks",
    "tiles:build": "node Tools/build-park-tiles.js",
    "trails:build": "node Tools/build-park-trails.js",
    "n1:build": "node Tools/catalogo-nacional/build-n1-espacios.js",
    "n1:refina": "node Tools/catalogo-nacional/refina-limites-imida.js",
    "habitats:build": "node Tools/catalogo-nacional/build-habitats.js",
    "habitats:merge": "node Tools/catalogo-nacional/merge-habitats.js",
    "habitats:adopt": "node Tools/catalogo-nacional/adopt-habitats.js",
    "atlas:hic": "node Tools/catalogo-nacional/atlas-hic-especies.js",
    "taxones:reconcilia": "node Tools/catalogo-nacional/reconcile-taxa.js",
    "invasoras:eei": "node Tools/catalogo-nacional/invasoras-eei.js",
    "habitats:check": "node Tools/sync-habitat-catalog.js",
    "habitats:apply": "node Tools/sync-habitat-catalog.js --apply --sql Database/habitats-universal.sql",
    "species:check": "node Tools/sync-species-catalog.js",
    "species:extract": "node Tools/sync-species-catalog.js --extract",
    "species:apply": "node Tools/sync-species-catalog.js --apply --sql Database/species-universal.sql",
    "images:species": "node Tools/catalogo-nacional/wikimedia-images.js --canonicalize --missing --write",
    "images:habitats": "node Tools/catalogo-nacional/habitat-images.js --write --sql Database/habitats-imagenes.sql",
    "images:invasoras": "node Tools/catalogo-nacional/invasoras-images.js --write --sql Database/invasoras-imagenes.sql",
    "contenido:invasoras": "node Tools/catalogo-nacional/invasoras-contenido.js --write --sql Database/invasoras-contenido.sql --preview Docs/fichas-invasoras.md",
    "eidos:diff": "node Tools/eidos-diff.js",
    "gbif:habitats": "node Tools/gbif-habitats.js"
  },
  "//dependencies": "polygon-clipping es la ÚNICA dependencia del repo. La usa el pipeline geográfico de Tools/catalogo-nacional (recorte de hábitats contra el límite del parque). Un recorte propio (Greiner-Hormann) falla con los tramos de costa colineales; ver Tools/catalogo-nacional/README.md. El resto del tooling sigue siendo zero-dep y la app (Frontend) no depende de nada.",
  "dependencies": {
    "polygon-clipping": "^0.15.7"
  }
}
