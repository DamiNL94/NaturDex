# NaturDex — proxy inverso con TLS automático (ver docker-compose.prod.yml).
#
# {$DOMAIN} se sustituye por la variable de entorno DOMAIN del contenedor:
#   - Con un dominio real (p. ej. naturdex.example.com), Caddy obtiene y renueva solo el
#     certificado de Let's Encrypt, y redirige HTTP→HTTPS automáticamente.
#   - Con DOMAIN=localhost (pruebas sin dominio), Caddy emite un certificado con su CA interna:
#     mismo comportamiento (HTTPS + redirección) pero el navegador avisará de que no es de
#     confianza.
{$DOMAIN} {
	# Compresión de las respuestas (el frontend son ficheros estáticos grandes: JS, GeoJSON…).
	encode zstd gzip

	# La entrada "/" se redirige aquí (no en Apache): Apache generaría una URL absoluta http:// al
	# ver solo HTTP en el tramo interno, forzando un salto extra por la redirección a HTTPS.
	redir / /Frontend/index.html

	# Todo el tráfico va al contenedor web (Apache+PHP) por la red interna de compose. Caddy añade
	# solo las cabeceras X-Forwarded-* (la API las usa para saber que el origen real es https).
	reverse_proxy web:80

	# Opcional (descomentar cuando el dominio sea definitivo): fuerza HTTPS también en visitas
	# futuras del navegador. No activar mientras se prueba con dominios/subdominios provisionales,
	# porque el navegador lo recuerda durante un año.
	# header Strict-Transport-Security "max-age=31536000"
}
